# Copy this file to `.env.local` in the same folder, then fill in values.
# In Cursor: open the project root → New File → name it exactly `.env.local`

# MongoDB (optional — without this, the app uses data/db.json)
MONGODB_URI=
MONGODB_DB=daycare

# Auth — use a long random string in production
AUTH_SECRET=

# Email (contact form via Resend — https://resend.com)
# 1) Create API key in Resend dashboard → add here as RESEND_API_KEY
# 2) RESEND_FROM: verified sender, e.g. onboarding@resend.dev (testing) or noreply@yourdomain.com
# 3) CONTACT_INBOX_EMAIL: where contact form copies go (defaults to NEXT_PUBLIC_CONTACT_EMAIL / site default)
RESEND_API_KEY=
RESEND_FROM=
CONTACT_INBOX_EMAIL=

# Shown on the site / contact (safe to expose with NEXT_PUBLIC_)
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profile URLs (optional)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_TWITTER=
